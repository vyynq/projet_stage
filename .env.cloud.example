# Variables a mettre dans le tableau de bord du cloud.
# Ne pas commiter de vraies valeurs secretes.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
FIELD_ENCRYPTION_KEY=GENERATE_ANOTHER_LONG_RANDOM_SECRET

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
UPLOAD_DIR=/app/app/uploads
CORS_ORIGINS=https://votre-domaine.example.com
PORT=8000
