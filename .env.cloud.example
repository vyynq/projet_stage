# Variables a mettre dans le tableau de bord du cloud.
# Ne pas commiter de vraies valeurs secretes.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
FIELD_ENCRYPTION_KEY=GENERATE_ANOTHER_LONG_RANDOM_SECRET

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
UPLOAD_DIR=/app/app/uploads
CORS_ORIGINS=https://votre-domaine.example.com
PORT=8000

# Mettre "smtp" quand les variables SMTP ci-dessous sont configurees.
# Laisser "console" pour afficher les codes dans les logs Render pendant une demo.
EMAIL_DELIVERY_MODE=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=compte@example.com
# SMTP_PASSWORD=mot_de_passe_smtp
# SMTP_FROM=no-reply@example.com
# SMTP_USE_TLS=true
