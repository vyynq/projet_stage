# Copier ce fichier en .env et adapter les valeurs
DATABASE_URL=postgresql://airbnb_user:changeme@localhost:5432/airbnb_menage

# Generer une cle forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_another_real_secret_key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
UPLOAD_DIR=/app/app/uploads
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8001
PORT=8000
